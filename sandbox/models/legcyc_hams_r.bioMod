	segment tibia_l_geom_2
		parent talus_l
		RTinMatrix	0
		RT	-0.0	 0.0	 -0.0	xyz	-0.0	 0.46	 -0.0
		//meshfile	Geometry/fibula_l.vtp
		meshcolor	1 1 1
		//meshscale	1.1237299999999999 1.1237299999999999 1.1237299999999999
	endsegment
	segment tibia_l
		parent tibia_l_geom_2
		RTinMatrix	0
		RT	0	 0	 0	xyz	0	 0	 0
		mass	4.6740424300000001
		inertia
			0.080235100000000004	0	0
			0	0.0081190299999999993	0
			0	0	0.081349500000000005
		com	0 -0.2739744 0
		//meshfile	Geometry/tibia_l.vtp
