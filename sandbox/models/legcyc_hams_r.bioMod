version 4

// File extracted from Models/leg6dof9musc_updt_bckup.osim
//Publication : Delp, S.L., Loan, J.P., Hoy, M.G., Zajac, F.E., Topp E.L., Rosen, J.M.: An interactive graphics-based model of the lower extremity to study orthopaedic surgical procedures, IEEE Transactions on Biomedical Engineering, vol. 37, pp. 757-767, 1990. Yamaguchi G.T., Zajac F.E.: A planar model of the knee joint to characterize the knee extensor mechanism." J . Biomecl7. vol. 21. pp. 1-10. 1989. Anderson F.C., Pandy M.G.: A dynamic optimization solution for vertical jumping in three dimensions. Computer Methods in Biomechanics and Biomedical Engineering 2:201-231, 1999. Anderson F.C., Pandy M.G.: Dynamic optimization of human walking. Journal of Biomechanical Engineering 123:381-390, 2001.
//Credit : Delp S.L., Loan J.P., Hoy M.G., Zajac F.E., Topp E.L., Rosen J.M., Thelen D.G., Anderson F.C., Seth A., Reinbolt J.A. Notes: 2D, 6 DOF leg model adpated by Jeff Reinbolt and Ajay Seth based on gait2354.osim Frank C. Anderson, and Scott L. Delp, Stanford University. Lower extremity joint defintions based on Delp et al. (1990). Low back joint and anthropometry based on Anderson and Pandy (1999, 2001). Planar knee model of Yamaguchi and Zajac (1989). Seth replaced tibia translation constraints with a CustomJoint for the knee and removed the patella to eliminate all kinematic constraints; insertions of the quadrucepts are handled with moving points in the tibia frame as defined by Delp 1990. Number of muscles were reduced by Reinbolt and Anderson to improve simulation speed for demonstrations and is not intended to be used in research. License: Creative Commons (CCBY 3.0). You are free to distribute, remix, tweak, and build upon this work, even commercially, as long as you credit us for the original creation. http://creativecommons.org/licenses/by/3.0/
//Force units : N
//Length units : meters

// Biomod not include all Osim features as the optimisation is performed on a third part software.
// The original file contained some of these features, corresponding warnings are shown in the end of the file.

    // vermelho         verde       azul
    gravity	-9.8066499999999994     0       0
    //making it reversal. starting from the gear to the hip
    //it will be necessary to create a contact points in the hip to constraint it from moving

    // CRANKSET
	segment Gear
		parent ground
		RTinMatrix	0
		RT	-0.0	 0.0	 -0.0	xyz	-0.0	 -0.0	 -0.0
		mass	1
		inertia
			0.001	0	0
			0	0.001	0
			0	0	0.001
		com	0 0 0
		meshfile	Geometry/gearSimple.obj
		meshcolor	1 1 1
		meshscale	1 1 1
		rotations z
		ranges
		        -10*pi 1*pi
	endsegment
	segment distance
	    parent ground
	    RTinMatrix	0
		RT	-0.0	 0.0	 -0.0	xyz	-0.0	 -0.0	 -0.0
		meshcolor	1 1 1
		mesh 0 0 0
		mesh 0 0.95 0
	endsegment
    segment distance_2
	    parent ground
	    RTinMatrix	0
		RT	-0.0	 0.0	 -0.0	xyz	-0.01	 -0.0	 -0.0
		meshcolor	1 1 1
		mesh 0 0 0
		mesh 0.0 0.78 0
	endsegment

    // RIGHT SIDE
	segment pedal_r
		parent Gear
		RTinMatrix	0
		RT	-0.0	 0.0	 0	xyz	-0.0 0.17 0.106
		mass	0.1
		inertia
			0.001	0	0
			0	0.001	0
			0	0	0.01
		com	0 0 0
		meshfile	Geometry/pedal.obj
		meshcolor	1 1 1
		meshscale	1 1 1
		rotations z
		ranges
		        -10*pi 10*pi
	endsegment
	segment Right_Foot_Support
		parent pedal_r
		RTinMatrix	0
		RT	-0.0	 0.0	 -0.0	xyz	-0.045	 -0.0	 -0.0
		mass	0.25
		inertia
			0.01	0	0
			0	0.01	0
			0	0	0.01
		com	0 0 0
		meshfile	Geometry/pedalWrap.obj
		meshcolor	1 1 1
		meshscale	1 1 1
	endsegment
	segment calcn_r
		parent Right_Foot_Support
		RTinMatrix	0
		RT	-0.0	 0.0	 -0.0	xyz	-0.1 0.015 0.000
		mass	1.07224816
		inertia
			0.00090461999999999997	0	0
			0	0.0036184799999999999	0
			0	0	0.0036184799999999999
		com	0.10269300000000001 0.030807899999999999 0
		meshfile	Geometry/foot.vtp
		meshcolor	1 1 1
		meshscale	1.0269299999999999 1.0269299999999999 1.0269299999999999
	endsegment
	segment talus_r
		parent calcn_r
		RTinMatrix	0
		RT	-0.0	 0.0	 -0.0	xyz	0.052050800000000003 0.053186400000000002 0.00
		mass	0.10000000000000001
		inertia
			0.001	0	0
			0	0.001	0
			0	0	0.001
		com	0 0 0
		meshfile	Geometry/talus.vtp
		meshcolor	1 1 1
		meshscale	1 1 1
	endsegment
	segment tibia_r_geom_2
		parent talus_r
		RTinMatrix	0
		RT	-0.0	 0.0	 -0.0	xyz	-0.0	 0.46 	 -0.0
		//meshfile	Geometry/fibula_r.vtp
		meshcolor	1 1 1
		//meshscale	1.1237299999999999 1.1237299999999999 1.1237299999999999
	endsegment
	segment tibia_r
		parent tibia_r_geom_2
		RTinMatrix	0
		RT	0	 0	 0	xyz	0	 0 	 0
		mass	4.6740424300000001
		inertia
			0.080235100000000004	0	0
			0	0.0081190299999999993	0
			0	0	0.081349500000000005
		com	0 -0.2739744 0
		//meshfile	Geometry/tibia_r.vtp
		mesh 0 0 0
		mesh -0.0	 -0.48	 -0.0
		meshcolor	1 1 1
		//meshscale	1.1237299999999999 1.1237299999999999 1.1237299999999999
	endsegment
	segment knee_r
		parent tibia_r
		RTinMatrix	0
		RT	0	 0	 0	xyz	0	 0 	 0
		rotations z
		ranges
				//0.92 2.01
				0.5 2.5
		mesh -0.0	 0.59	 -0.0
		mesh 0 0 0
		meshcolor	1 1 1
	endsegment
	segment patella_r
		parent tibia_r
		RTinMatrix	0
		RT	-0.0	 0.0	 0.15	xyz	0.025	 -0.03	 -0.0
		mass	0.106083466666667
		inertia
			3.8735899999999998e-06	0	0
			0	1.3955699999999999e-05	0
			0	0	1.3955699999999999e-05
		com	0.0016462899999999999 0.031656299999999998 0
