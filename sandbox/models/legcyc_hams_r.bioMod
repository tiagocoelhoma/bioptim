    //MARKERS
    marker pedal_marker_r
        parent pedal_r
        position -0.0 0.00  -0.00
    endmarker
    marker pedal_marker_l
        parent pedal_l
        position -0.0 0.00  0.00
    endmarker
    // contact points to constraint the pelvis for no movement.
   contact contact_femur_r   //should be the same as the marker above
        parent femur_r
        position 0 0 0
        axis xy
    endcontact
    contact contact_femur_l   //should be the same as the marker above
        parent femur_l
        position 0 0 0
        axis xy
    endcontact

    contact contact_pelvis_r
       parent pelvis_r
        position 0.081 0.08  -0.105
        axis x
    endcontact
    contact contact_pelvis_l
       parent pelvis_l
        position 0.081 0.08  0.105
        axis x
    endcontact

    // MUSCLE DEFINIION
    // pelvis > tibia (workaround for knee joint)
    musclegroup pelvis_to_tibia_r
        OriginParent	pelvis_r
        InsertionParent	tibia_r
    endmusclegroup

    // femur_r > tibia_r
    musclegroup femur_r_to_tibia_r
        OriginParent	femur_r
        InsertionParent	tibia_r
    endmusclegroup

 /*   //  hamstrings_r
    muscle	bfsh140_r
		type	hilldegroote
		statetype	degroote
		musclegroup	femur_r_to_tibia_r
		OriginPosition	0.0045730399999999996 -0.25458700000000001 0.021401799999999999
		InsertionPosition	-0.026367000000000002 -0.032104199999999999 0.029476599999999999
		optimalLength	0.129314904926146
		maximalForce	557.11475409835998
		tendonSlackLength	0.12405932512602499
		pennationAngle	0.26422317000000001
		a_scale         1721
		ding_tau_1      0.055
		ding_tau_2      0.0011
        ding_km         0.144
	endmuscle
*/
	muscle	bflh140_r
		type	hilldegroote
		statetype	degroote
		musclegroup	pelvis_to_tibia_r
		OriginPosition	-0.095110899999999998 -0.13321 0.076466699999999999
		//InsertionPosition	-0.024876700000000002 -0.048957899999999999 0.0031979
		InsertionPosition	-0.024876700000000002 -0.038957899999999999 0.0031979
		optimalLength	0.115637614434919
		maximalForce	100000 //1313.18360655738
		tendonSlackLength	0.39394986475011001
		pennationAngle	0.17591823000000001
		a_scale         1721
		ding_tau_1      0.055
		ding_tau_2      0.0011
        ding_km         0.144
	endmuscle
		viapoint	bflh_r-P2
			parent	femur_r
			muscle	bflh140_r
			musclegroup	pelvis_to_tibia_r
			position	-0.031611 -0.435662600000000003 0.0332854
		endviapoint
