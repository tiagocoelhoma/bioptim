		meshcolor	1 1 1
		meshscale	0.91460699999999995 1.1991000000000001 0.91460699999999995
	endsegment
	segment femur_r
		parent knee_r
		RTinMatrix	0
		RT	-0.0	 0.0	 -0.0	xyz	-0.0	 0.59	 -0.0
		mass	8.5492663199999992
		inertia
			0.16956399999999999	0	0
			0	0.0444489	0
			0	0	0.178809
		com	0 -0.33453 0
		//meshfile	Geometry/femur_r.vtp
		//mesh -0.0	 -0.59 	 -0.0
		//mesh 0 0 0
		//meshcolor	1 1 1
		//meshscale	1.17378 1.17378 1.17378
	endsegment
	segment hip_r
		parent femur_r
		RTinMatrix	0
		//RT	-0.0	 0.0	 -pi	xyz	-0.0	 0.0	 -0.0
		RT	-0.0	 0.0	 -pi/2	xyz	-0.0	 0.0	 -0.0
		rotations z
		ranges
				-pi pi
	endsegment
	segment pelvis_r
		parent hip_r
		RTinMatrix	0
		RT	0 0	0	xyz	0.081 0.08  -0.105
		// data from mass, COM and inertia were taken from femur. Need to be reviewed
		mass	8.5492663199999992
		inertia
		    10.0	0	0
			0	10.0	0
			0	0	10.0
		com	0 0 0
		meshfile	Geometry/r_pelvis.vtp
		meshcolor	1 1 1
		meshscale	1.04599 1.04599 1.04599
	endsegment

