// MUSCLE DEFINIION

// pelvis > femur_r
musclegroup pelvis_to_femur_r
	OriginParent	pelvis
	InsertionParent	femur_r
endmusclegroup

// pelvis > tibia_r
musclegroup pelvis_to_tibia_r
	OriginParent	pelvis
	InsertionParent	tibia_r
endmusclegroup

